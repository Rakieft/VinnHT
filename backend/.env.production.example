NODE_ENV=production
PORT=5056
FRONTEND_URL=https://vinnht.example
DB_HOST=localhost
DB_PORT=3306
DB_USER=vinnht_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=vinnht
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=24h
COMMISSION_RATE=0.10
TRUST_PROXY=true

# Cloudinary recommandé en production
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Laisser vide derrière un reverse proxy HTTPS.
# Renseigner les deux chemins pour servir HTTPS directement depuis Node.
SSL_KEY_PATH=
SSL_CERT_PATH=

BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30
MESSAGE_RETENTION_DAYS=30
DELIVERY_HISTORY_RETENTION_DAYS=60
